<UserControl x:Class="BMPharma.UI.Views.ChifaInvoicePreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPharma.UI.ViewModels">
    <UserControl.DataContext>
        <vm:ChifaInvoicePreparationViewModel />
    </UserControl.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Préparation facture CHIFA" FontSize="22" FontWeight="Bold"
                       Foreground="#1B5E20" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Padding="8,4" CornerRadius="3" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#FFF3E0" />
                    </Border.Background>
                    <TextBlock Text="{Binding ModeNotice}" FontSize="12" FontWeight="Bold" Foreground="#FF9800" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: Status Cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,8">
            <!-- Mode -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="Mode" FontSize="10" Foreground="#757575" />
                    <TextBlock Text="{Binding IntegrationMode}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- Connection -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="PostgreSQL" FontSize="10" Foreground="#757575" />
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- Validation -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="Validation" FontSize="10" Foreground="#757575" />
                    <TextBlock Text="{Binding ValidationStatus}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- CHIFA -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="CHIFA" FontSize="10" Foreground="#757575" />
                    <TextBlock Text="{Binding ChifaStatus}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- Workflow -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="Workflow" FontSize="10" Foreground="#757575" />
                    <TextBlock Text="{Binding WorkflowStep}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Row 2: Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Invoice Form -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                    Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Patient Info -->
                    <TextBlock Grid.Row="0" Text="Informations facture" FontSize="16" FontWeight="Bold"
                               Foreground="#1B5E20" Margin="0,0,0,8" />
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="N° facture:" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Margin="0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="N° assurance:" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding InsuranceNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Code centre:" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CentreCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Date soin:" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding CareDate}" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Patient:" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="N° facture CHIFA:" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding NumFactDisplay}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4" />
                    </Grid>

                    <!-- Invoice Lines -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Lignes de facture" FontSize="14" FontWeight="Bold"
                                   Foreground="#1B5E20" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Ajouter ligne" Command="{Binding AddLineCommand}" Padding="8,4" Margin="0,0,4,0" />
                            <Button Content="Vider" Command="{Binding ClearFormCommand}" Padding="8,4" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding InvoiceLines}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                              BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" />
                            <DataGridTextColumn Header="N° enreg." Binding="{Binding NumEnr, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Produit" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Code CIP" Binding="{Binding CipCode, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Qte" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Prix unit." Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="80" />
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="80" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Amounts -->
                    <Border Grid.Row="3" Background="#F5F5F5" Padding="8" CornerRadius="3" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Montants:" FontWeight="Bold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                                <TextBlock Text="Total: " VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                                <TextBlock Text="Prise en charge (70%): " VerticalAlignment="Center" Foreground="#4CAF50" />
                                <TextBlock Text="{Binding ReimbursementAmount, StringFormat=N2}" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0">
                                <TextBlock Text="Reste à payer: " VerticalAlignment="Center" Foreground="#F44336" />
                                <TextBlock Text="{Binding PatientShare, StringFormat=N2}" FontWeight="Bold" Foreground="#F44336" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Valider" Command="{Binding ValidateInvoiceCommand}" Padding="16,8"
                                Margin="0,0,8,0" FontWeight="Bold" Background="#4CAF50" Foreground="White" />
                        <Button Content="Préparer et soumettre" Command="{Binding PrepareAndSubmitCommand}" Padding="16,8"
                                FontWeight="Bold" Background="#1B5E20" Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Status & Audit -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Required Action -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="12" CornerRadius="4"
                        Visibility="{Binding HasRequiredAction, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="#FF9800" BorderThickness="1" Background="#FFF3E0">
                    <StackPanel>
                        <TextBlock Text="ACTION REQUISE" FontSize="14" FontWeight="Bold"
                                   Foreground="#E65100" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding RequiredActionTitle}" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,4" />
                        <TextBlock FontSize="12" Foreground="#1B5E20">
                            <Run Text="Application: " FontWeight="SemiBold" />
                            <Run Text="{Binding RequiredActionApplication, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding RequiredActionBmPharmaWaits}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,4,0,0" Foreground="#424242" />
                    </StackPanel>
                </Border>

                <!-- Errors -->
                <Border Grid.Row="1" Margin="0,0,0,8" Padding="12" CornerRadius="4"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="#F44336" BorderThickness="1" Background="#FFEBEE">
                    <StackPanel>
                        <TextBlock Text="Erreurs de validation" FontSize="14" FontWeight="Bold"
                                   Foreground="#D32F2F" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="8" Margin="0,0,0,4" CornerRadius="3"
                                            BorderBrush="#FFCDD2" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D32F2F">
                                                <Run Text="{Binding Code, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Field, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Workflow State -->
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="État du workflow" FontSize="14" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="État:" Foreground="#757575" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentStateDescription}" FontWeight="Bold" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Étape:" Foreground="#757575" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkflowStep}" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode:" Foreground="#757575" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IntegrationMode}" Margin="0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Corrélation:" Foreground="#757575" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastCorrelationId}" FontSize="11" Margin="0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Prochain bordereau:" Foreground="#757575" Margin="0,4" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NextBordereauNumber}" Margin="0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audit Log -->
                <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                        Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Journal d'audit" FontSize="14" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  HeadersVisibility="Column" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Heure" Binding="{Binding Timestamp}" Width="70" />
                                <DataGridTextColumn Header="Opération" Binding="{Binding Operation}" Width="100" />
                                <DataGridTextColumn Header="Résultat" Binding="{Binding Result}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 3: Status Bar -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="8" CornerRadius="3" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#757575" />
                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#757575">
                    <Run Text="Mode: " />
                    <Run Text="{Binding IntegrationMode, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" | " />
                    <Run Text="{Binding CurrentStateDescription, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
