<UserControl x:Class="BMPharma.UI.Views.ChifaInvoicePreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPharma.UI.ViewModels">
    <UserControl.DataContext>
        <vm:ChifaInvoicePreparationViewModel />
    </UserControl.DataContext>
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="CHIFA Invoice Preparation" FontSize="22" FontWeight="Bold"
                       Foreground="#1B5E20" Margin="0,0,0,16" />

            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="16" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice Number:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNumber}"
                             MaxLength="8" Margin="0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Insurance Number:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InsuranceNumber}"
                             MaxLength="12" Margin="0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Centre Code:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CentreCode}"
                             Margin="0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Care Date:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding CareDate}"
                                Margin="0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ValidationStatus}"
                               Foreground="#4CAF50" FontSize="14" Margin="0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Error:"
                               VerticalAlignment="Center" Margin="0,8" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastError}"
                               Foreground="#F44336" FontSize="14" Margin="0,8" />
                </Grid>
            </Border>

            <TextBlock Text="Note: Invoice validation applies CHIFA constraints before database write."
                       FontSize="12" Foreground="#757575" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
