<UserControl x:Class="BMPharma.UI.Views.ChifaDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPharma.UI.ViewModels">
    <UserControl.DataContext>
        <vm:ChifaDashboardViewModel />
    </UserControl.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="CHIFA Integration Dashboard"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,16"
                   Foreground="#1B5E20" />

        <!-- Status Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <!-- Connection Status -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="PostgreSQL" FontSize="12" Foreground="#757575" />
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" FontWeight="Bold"
                               Foreground="#F44336" />
                </StackPanel>
            </Border>

            <!-- Integration Mode -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Mode" FontSize="12" Foreground="#757575" />
                    <TextBlock Text="{Binding IntegrationMode}" FontSize="16" FontWeight="Bold"
                               Foreground="#FF9800" />
                </StackPanel>
            </Border>

            <!-- Invoices Prepared -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Invoices Prepared" FontSize="12" Foreground="#757575" />
                    <TextBlock Text="{Binding PreparedInvoiceCount}" FontSize="16" FontWeight="Bold"
                               Foreground="#4CAF50" />
                </StackPanel>
            </Border>

            <!-- Bordereaux -->
            <Border BorderBrush="#C8E6C9" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Bordereaux" FontSize="12" Foreground="#757575" />
                    <TextBlock Text="{Binding BordereauCount}" FontSize="16" FontWeight="Bold"
                               Foreground="#2196F3" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Content Area -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab Headers -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F5F5F5" Padding="8">
                    <Button Content="CHIFA Status" Padding="12,6" Margin="0,0,4,0"
                            BorderThickness="0" Background="Transparent" />
                    <Button Content="Invoice Preparation" Padding="12,6" Margin="0,0,4,0"
                            BorderThickness="0" Background="Transparent" />
                    <Button Content="Bordereau Management" Padding="12,6" Margin="0,0,4,0"
                            BorderThickness="0" Background="Transparent" />
                </StackPanel>

                <!-- Content -->
                <TextBlock Grid.Row="1"
                           Text="CHIFA Integration Dashboard - Under Construction&#10;&#10;This dashboard will display:&#10;- PostgreSQL connection status&#10;- CHIFA-OFFICINE availability&#10;- Invoice preparation queue&#10;- Bordereau lifecycle tracking&#10;- Signing status (delegated to CHIFA)&#10;- Audit log"
                           FontSize="14" Foreground="#757575"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
